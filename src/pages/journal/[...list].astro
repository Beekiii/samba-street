---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getPublishedPosts, postUrl, formatDate, isoDate, type Post } from "../../journal";

// The Journal stays off the website until the first post is published:
// with no posts, /journal/ isn't built at all. A normal page is always built,
// so this is a [...rest] route, where getStaticPaths can return nothing.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.length > 0 ? [{ params: { list: undefined }, props: { posts } }] : [];
}

const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout
  title="Journal – Samba Street"
  description="News and stories from Samba Street, a non-profit football academy in Khayelitsha, Cape Town."
>
  <SiteHeader current="journal" />

  <main class="wrap">
    <h1>Journal<span class="dot">.</span></h1>

    {
      posts.map((post, i) => (
        <a class="entry" href={postUrl(post)}>
          <figure>
            <Image
              src={post.data.cover}
              alt=""
              widths={[480, 720, 1080]}
              sizes="(min-width: 720px) 460px, calc(100vw - 32px)"
              loading={i < 2 ? "eager" : "lazy"}
            />
          </figure>
          <div class="entry-text">
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <h2>{post.data.title}</h2>
            {post.data.summary && <p>{post.data.summary}</p>}
            <span class="read">Read →</span>
          </div>
        </a>
      ))
    }
  </main>

  <SiteFooter line />
</BaseLayout>

<style>
  h1 {
    padding: 96px 0 56px;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .dot {
    color: var(--sun);
  }

  /* One row per post: photo and text side by side, alternating sides. */
  .entry {
    display: grid;
    gap: 24px;
    padding: 56px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }
  @media (min-width: 720px) {
    .entry {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    /* As in the mockup: the newest post has its photo on the right. */
    .entry:nth-of-type(odd) figure {
      order: 2;
    }
  }
  figure {
    margin: 0;
    overflow: hidden;
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .entry:hover figure :global(img) {
    transform: scale(1.03);
  }
  time {
    font-size: 0.875rem;
    color: var(--muted);
  }
  h2 {
    margin-top: 8px;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .entry-text p {
    margin-top: 14px;
    color: var(--muted);
    max-width: 30em;
  }
  .read {
    display: inline-block;
    margin-top: 20px;
    border-bottom: 2px solid var(--sun);
    padding-bottom: 2px;
  }
  .entry:hover .read {
    border-color: var(--accent);
  }
</style>
