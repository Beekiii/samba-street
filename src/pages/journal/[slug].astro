---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getPublishedPosts, formatDate, isoDate, type Post } from "../../journal";
import { CONTACT_EMAIL } from "../../site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, date, summary, cover, coverAlt } = post.data;
const { Content } = await render(post);

// A smaller JPG of the cover for link previews (WhatsApp, Facebook and so on).
const shareImage = await getImage({ src: cover, width: 1200, format: "jpg" });
---

<BaseLayout
  title={`${title} – Samba Street`}
  description={summary ?? undefined}
  image={shareImage.src}
  ogType="article"
>
  <header class="post-hero">
    <Image
      class="post-hero-img"
      src={cover}
      alt={coverAlt ?? ""}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="post-hero-shade"></div>
    <SiteHeader overlay />
    <div class="wrap post-hero-content">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <h1>{title}</h1>
    </div>
  </header>

  <main class="wrap">
    <article class="prose">
      <Content />
    </article>

    <div class="post-end">
      <a href="/journal/">← All journal entries</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </main>

  <SiteFooter line />
</BaseLayout>

<style>
  /* ---------- Photo header, like the homepage hero ---------- */
  .post-hero {
    position: relative;
    min-height: 72vh;
    min-height: 72svh;
    display: flex;
    flex-direction: column;
    color: #fff;
    overflow: hidden;
  }
  @media (min-width: 720px) {
    .post-hero {
      min-height: 78vh;
      min-height: 78svh;
    }
  }
  .post-hero :global(.post-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0) 30%,
      rgba(0, 0, 0, 0.15) 55%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }
  .post-hero-content {
    position: relative;
    margin-top: auto;
    padding-top: 48px;
    padding-bottom: 56px;
  }
  .post-hero-content time {
    font-size: 0.875rem;
    opacity: 0.85;
  }
  h1 {
    margin-top: 10px;
    max-width: 13em;
    font-size: clamp(2.5rem, 7vw, 5.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    overflow-wrap: break-word;
  }

  /* ---------- Post text (written in Pages CMS) ---------- */
  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 72px;
    font-size: 1.1875rem;
    line-height: 1.65;
    overflow-wrap: break-word;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin: 0 0 1.1em;
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin: 1.8em 0 0.5em;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
  }
  .prose :global(li + li) {
    margin-top: 0.3em;
  }
  .prose :global(a) {
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--accent);
  }
  .prose :global(blockquote) {
    padding-left: 1em;
    border-left: 2px solid var(--sun);
    color: var(--muted);
  }
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 2.2em 0;
  }
  .prose :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }
  .prose > :global(:last-child) {
    margin-bottom: 0;
  }

  /* ---------- Links under the post ---------- */
  .post-end {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    max-width: 720px;
    margin: 72px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .post-end a {
    text-decoration: none;
    border-bottom: 2px solid var(--sun);
    padding-bottom: 2px;
    overflow-wrap: anywhere;
  }
  .post-end a:hover {
    border-color: var(--accent);
  }
</style>
